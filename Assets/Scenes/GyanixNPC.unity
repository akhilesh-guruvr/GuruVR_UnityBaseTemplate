    - target: {fileID: 8273661614932620855, guid: b598cb26d5f7ea74ebe8d37dc0a0aef3, type: 3}
      propertyPath: supportedLanguages.Array.data[0].firstMessage
      value: "Welcome to GuruVR Metaversity \u2014 where learning is super personal,
        fully immersive, and packed with endless possibilities! \nHere, you set the
        pace.\nYou explore new worlds, unlock fresh experiences, and level up your
        confidence every single day! \nI\u2019m Counsellor Tara Deshpande \u2014
        your guide, your supporter, and your hype-partner on this journey! \nSo let\u2019s
        turn curiosity into your superpower and imagination into your biggest achievement!
        \nReady to level up your future? Let\u2019s dive in! "
      objectReference: {fileID: 0}
    - target: {fileID: 8273661614932620855, guid: b598cb26d5f7ea74ebe8d37dc0a0aef3, type: 3}
      propertyPath: supportedLanguages.Array.data[1].firstMessage
      value: "Welcome to GuruVR Metaversity \u2014\n\n\u091C\u0939\u093E\u0901 learning
        \u0939\u094B\u0924\u0940 \u0939\u0948 super personal, immersive \u0914\u0930
        possibilities \u0938\u0947 full-on packed!\n\u092F\u0939\u093E\u0901 \u0906\u092A
        \u0905\u092A\u0928\u0940 pace \u0938\u0947 explore \u0915\u0930\u0924\u0947
        \u0939\u0948\u0902,\n\n\u0928\u090F experiences unlock \u0915\u0930\u0924\u0947
        \u0939\u0948\u0902,\n\n\u0914\u0930 \u0939\u0930 \u0926\u093F\u0928 confidence
        \u0915\u093E \u0928\u092F\u093E level \u0939\u093E\u0938\u093F\u0932 \u0915\u0930\u0924\u0947
        \u0939\u0948\u0902! \n\u092E\u0948\u0902 \u0939\u0942\u0901 Counsellor Tara
        Deshpande \u2014\n\n\u0906\u092A\u0915\u0940 \u0907\u0938 adventure journey
        \u0915\u0940 guide, supporter \u0914\u0930 hype-partner! \n\u0924\u094B \u091A\u0932\u093F\u090F
        \u0938\u093E\u0925 \u092E\u093F\u0932\u0915\u0930 curiosity \u0915\u094B
        superpower \u092C\u0928\u093E\u0924\u0947 \u0939\u0948\u0902,\n\n\u0914\u0930
        imagination \u0915\u094B \u0906\u092A\u0915\u0940 \u0938\u092C\u0938\u0947
        \u092C\u0921\u093C\u0940 achievement! \nReady to level up? Let\u2019s begin!
        \n"
      objectReference: {fileID: 0}
    - target: {fileID: 8273661614932620855, guid: b598cb26d5f7ea74ebe8d37dc0a0aef3, type: 3}
      propertyPath: supportedLanguages.Array.data[2].firstMessage
      value: "Welcome to GuruVR Metaversity \u2014\n\n\u0907\u0925\u0947 learning
        \u0939\u094B\u0924\u0902 \u0916\u0930\u0902\u091A personal, immersive \u0906\u0923\u093F
        possibilities \u0928\u0947 \u092B\u0941\u0932\u094D\u0932 \u092D\u0930\u0932\u0947\u0932\u0902!
        \n\u0907\u0925\u0947 \u0924\u0941\u092E\u094D\u0939\u0940 \u0924\u0941\u092E\u091A\u094D\u092F\u093E
        pace \u0928\u0947 explore \u0915\u0930\u0924\u093E,\n\n\u0928\u0935\u0947
        experiences unlock \u0915\u0930\u0924\u093E,\n\n\u0906\u0923\u093F \u0926\u0930\u0930\u094B\u091C
        confidence \u091A\u093E next level \u0917\u093E\u0920\u0924\u093E! \n\u092E\u0940
        \u0906\u0939\u0947 Counsellor \u0924\u093E\u0930\u093E \u0926\u0947\u0936\u092A\u093E\u0902\u0921\u0947
        \u2014\n\n\u0924\u0941\u092E\u091A\u094D\u092F\u093E \u092F\u093E adventure
        journey \u091A\u0940 guide, supporter \u0906\u0923\u093F hype-partner! \n\u091A\u0932\u093E
        \u0924\u0930 \u092E\u0917, curiosity \u0932\u093E superpower \u092C\u0928\u0935\u0942\n\n\u0906\u0923\u093F
        imagination \u0932\u093E \u0924\u0941\u092E\u091A\u0940 \u0938\u0930\u094D\u0935\u093E\u0924
        \u092E\u094B\u0920\u0940 achievement! \nReady to level up? Let\u2019s begin!
        \n"
      objectReference: {fileID: 0}
